fruits=["apple","banana","orange","cherry","strawberry"]
print("Original list:",fruits)
Original list:['apple', 'banana', 'orange', 'cherry', 'strawberry']

#Access by index
print("first fruit",fruits[0])
first fruit apple

#list comprehenision
upper_fruits=[fruit.upper()for fruit in fruits]
print("uppercase friuts:",upper_fruits)
uppercase fruits: ['APPLE', 'BANANA', 'ORANGE', 'CHERRY', 'STRAWBERRY']

